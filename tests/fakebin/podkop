#!/usr/bin/env python3
"""Фейковый /usr/bin/podkop для тестов."""
import json, os, sys
a = sys.argv[1:]
d = os.environ.get("FAKE_UCI_DIR", "")
if a[:1] == ["get_sing_box_status"]:
    print('{"running":1,"enabled":1,"status":"running & enabled","dns_configured":1,"version":"1.12.4"}')
elif a[:2] == ["clash_api", "get_proxies"]:
    p = os.path.join(d, "active")
    now = open(p).read() if os.path.exists(p) else "Proxy-1-out"
    print(json.dumps({"proxies": {"Proxy-out": {"now": now}}}))
elif a[:2] == ["clash_api", "get_proxy_latency"]:
    cfg = json.load(open(os.environ["PODKOP_SUB_SINGBOX_CONFIG"]))
    ob = next((o for o in cfg["outbounds"] if o["tag"] == a[2]), None)
    dead = open(os.path.join(d, "dead")).read().split() if os.path.exists(os.path.join(d, "dead")) else []
    if ob is None or ob.get("server") in dead:
        print('{"message":"An error occurred in the delay test"}')
    else:
        print('{"delay":42}')
elif a[:2] == ["clash_api", "set_group_proxy"]:
    open(os.path.join(d, "active"), "w").write(a[3])
    print('{"success":true}')
else:
    sys.exit(1)
